{
  "name": "harness-hehehe",
  "version": "0.3.14",
  "description": "Install the hehehe Codex workflow plugin globally or in one project.",
  "type": "module",
  "bin": {
    "harness-hehehe": "bin/hehehe.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "plugins/hehehe/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "USAGE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "maintenance:check": "node plugins/hehehe/skills/maintain-codebase/scripts/maintenance-audit.mjs scan --project . --json",
    "validate": "node scripts/check-syntax.mjs && npm test",
    "verification:ci": "node plugins/hehehe/skills/resume/scripts/ci-verification.mjs ."
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0nghee/harness-hehehe.git"
  },
  "homepage": "https://github.com/d0nghee/harness-hehehe#readme",
  "bugs": {
    "url": "https://github.com/d0nghee/harness-hehehe/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "codex",
    "plugin",
    "workflow",
    "claude",
    "development"
  ],
  "license": "MIT"
}
